\@writefile{toc}{\contentsline {subsection}{\numberline {10.7}Intensity Change Analysis}{28}{subsection.10.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Storm intensity change analysis. Top-left: distribution of 6-hourly wind changes with RI ($\geq +30$~kt) and Rapid Weakening (RW, $\leq -30$~kt) thresholds marked. The distribution is strongly peaked at zero change. Top-right: counts of RI and RW events vs total observations; both RI and RW events are rare relative to the total. Bottom-left: scatter of wind change vs sun altitude angle (5{,}000-sample subset) --- no trend is discernible. Bottom-right: scatter of wind change vs moon ecliptic longitude --- no systematic relationship is visible.}}{28}{figure.caption.28}\protected@file@percent }
\newlabel{fig:intensity}{{17}{28}{Storm intensity change analysis. Top-left: distribution of 6-hourly wind changes with RI ($\geq +30$~kt) and Rapid Weakening (RW, $\leq -30$~kt) thresholds marked. The distribution is strongly peaked at zero change. Top-right: counts of RI and RW events vs total observations; both RI and RW events are rare relative to the total. Bottom-left: scatter of wind change vs sun altitude angle (5{,}000-sample subset) --- no trend is discernible. Bottom-right: scatter of wind change vs moon ecliptic longitude --- no systematic relationship is visible}{figure.caption.28}{}}
