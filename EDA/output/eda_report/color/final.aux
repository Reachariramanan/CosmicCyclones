\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Four-panel publication figure. \textbf  {(A)} Model RMSE comparison; meteorological baseline (dashed blue) is the best-performing model and adding Vedic features monotonically increases error. \textbf  {(B)} Feature group RMSE lift; Vedic/Panchang lift of 0.010~kt is negligible relative to the meteorological group's 0.582~kt. \textbf  {(C)} RI rate by lunar phase (24-h rolling window); Waning Crescent (dark red) is the peak phase, dashed line marks overall mean RI rate. \textbf  {(D)} Top-10 Spearman $\rho $ between planetary speed and storm bearing; all negative (faster speed $\to $ more westward track) and statistically significant but small ($r^2 < 0.032$).}}{21}{figure.caption.19}\protected@file@percent }
\newlabel{fig:pub}{{11}{21}{Four-panel publication figure. \textbf {(A)} Model RMSE comparison; meteorological baseline (dashed blue) is the best-performing model and adding Vedic features monotonically increases error. \textbf {(B)} Feature group RMSE lift; Vedic/Panchang lift of 0.010~kt is negligible relative to the meteorological group's 0.582~kt. \textbf {(C)} RI rate by lunar phase (24-h rolling window); Waning Crescent (dark red) is the peak phase, dashed line marks overall mean RI rate. \textbf {(D)} Top-10 Spearman $\rho $ between planetary speed and storm bearing; all negative (faster speed $\to $ more westward track) and statistically significant but small ($r^2 < 0.032$)}{figure.caption.19}{}}
