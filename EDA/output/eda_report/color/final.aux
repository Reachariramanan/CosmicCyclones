\@writefile{toc}{\contentsline {subsection}{\numberline {10.3}Nakshatra Intensity Analysis}{23}{subsection.10.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Nakshatra vs Intensity classification (High/Low wind speed split). The chi-squared test ($\chi ^2 = 106.04$, $p < 0.0001$) is statistically significant, but the variation in High/Low split percentages across the 27 Nakshatras spans only $\approx 4$--8 percentage points, consistent with a trivially small effect size. Thiruvathirai shows the lowest High-intensity fraction ($\approx 48\%$) while Anusham shows the highest ($\approx 58\%$).}}{23}{figure.caption.21}\protected@file@percent }
\newlabel{fig:nakshatra}{{12}{23}{Nakshatra vs Intensity classification (High/Low wind speed split). The chi-squared test ($\chi ^2 = 106.04$, $p < 0.0001$) is statistically significant, but the variation in High/Low split percentages across the 27 Nakshatras spans only $\approx 4$--8 percentage points, consistent with a trivially small effect size. Thiruvathirai shows the lowest High-intensity fraction ($\approx 48\%$) while Anusham shows the highest ($\approx 58\%$)}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.4}Tithi $\times $ Nakshatra Interaction Heatmaps}{24}{subsection.10.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Mean wind speed (kt) by Tithi (rows) and Nakshatra (columns). Darker cells indicate higher mean wind. Isolated high values (e.g., Pournami $\times $ Mirugasirisham = 74~kt; Egadashi $\times $ Moolam = 71~kt) reflect small cell counts rather than systematic astronomical effects. No systematic high-intensity zone is visible across any Tithi--Nakshatra combination.}}{24}{figure.caption.22}\protected@file@percent }
\newlabel{fig:tn_mean}{{13}{24}{Mean wind speed (kt) by Tithi (rows) and Nakshatra (columns). Darker cells indicate higher mean wind. Isolated high values (e.g., Pournami $\times $ Mirugasirisham = 74~kt; Egadashi $\times $ Moolam = 71~kt) reflect small cell counts rather than systematic astronomical effects. No systematic high-intensity zone is visible across any Tithi--Nakshatra combination}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Median wind speed (kt) by Tithi (rows) and Nakshatra (columns). More robust to outliers than the mean heatmap. The Thirayodasi $\times $ Bharani cell shows the highest median (89~kt) but represents very few observations. The overall range of medians ($\approx 20$--90~kt) reflects natural cyclone lifecycle variation rather than systematic Vedic calendar effects.}}{25}{figure.caption.23}\protected@file@percent }
\newlabel{fig:tn_median}{{14}{25}{Median wind speed (kt) by Tithi (rows) and Nakshatra (columns). More robust to outliers than the mean heatmap. The Thirayodasi $\times $ Bharani cell shows the highest median (89~kt) but represents very few observations. The overall range of medians ($\approx 20$--90~kt) reflects natural cyclone lifecycle variation rather than systematic Vedic calendar effects}{figure.caption.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.5}Retrograde Planetary Motion and Storm Intensity}{25}{subsection.10.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Retrograde effects on storm intensity. Left panel: retrograde percentage by planet (Varun retrograde 60\% of all observations, making its retrograde phase the majority condition). Right panel: median wind speed difference (retrograde $-$ direct). Shukra (Venus) shows the largest difference (+5~kt) but is retrograde in only 7.9\% of observations and has rank-biserial $r = 0.044$ (small). Guru (Jupiter) shows a negative difference ($-2$~kt). All effects are statistically significant at $p < 0.001$ due to large $N$, but all effect sizes are small ($|r_{\text  {rb}}| < 0.10$, Cohen's $d < 0.15$).}}{25}{figure.caption.24}\protected@file@percent }
\newlabel{fig:retrograde}{{15}{25}{Retrograde effects on storm intensity. Left panel: retrograde percentage by planet (Varun retrograde 60\% of all observations, making its retrograde phase the majority condition). Right panel: median wind speed difference (retrograde $-$ direct). Shukra (Venus) shows the largest difference (+5~kt) but is retrograde in only 7.9\% of observations and has rank-biserial $r = 0.044$ (small). Guru (Jupiter) shows a negative difference ($-2$~kt). All effects are statistically significant at $p < 0.001$ due to large $N$, but all effect sizes are small ($|r_{\text {rb}}| < 0.10$, Cohen's $d < 0.15$)}{figure.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Retrograde vs direct planetary motion: Mann--Whitney $U$ results. $r_{\text  {rb}}$ = rank-biserial correlation; $d$ = Cohen's $d$. All effects classified as small ($|r_{\text  {rb}}| < 0.10$).}}{26}{table.caption.25}\protected@file@percent }
\newlabel{tab:retro}{{10}{26}{Retrograde vs direct planetary motion: Mann--Whitney $U$ results. $r_{\text {rb}}$ = rank-biserial correlation; $d$ = Cohen's $d$. All effects classified as small ($|r_{\text {rb}}| < 0.10$)}{table.caption.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.6}Planetary Aspect Correlations}{26}{subsection.10.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Pearson correlations of planetary aspect angles with wind speed. The Jupiter--Saturn aspect shows the highest positive correlation ($r = 0.077$); Venus--Jupiter shows the most negative ($r = -0.039$). All correlations are weak ($|r| < 0.10$), explaining less than 0.6\% of variance in wind speed. These are the weakest systematic signals in the entire dataset.}}{26}{figure.caption.26}\protected@file@percent }
\newlabel{fig:aspects}{{16}{26}{Pearson correlations of planetary aspect angles with wind speed. The Jupiter--Saturn aspect shows the highest positive correlation ($r = 0.077$); Venus--Jupiter shows the most negative ($r = -0.039$). All correlations are weak ($|r| < 0.10$), explaining less than 0.6\% of variance in wind speed. These are the weakest systematic signals in the entire dataset}{figure.caption.26}{}}
