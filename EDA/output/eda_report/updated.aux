\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Top-30 features by Mutual Information with wind speed. Ayanamsha and Rahu/Ketu degree features lead due to temporal confounding. Meteorological features (latitude, spline geometry) follow.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:mi_top30}{{3}{4}{Top-30 features by Mutual Information with wind speed. Ayanamsha and Rahu/Ketu degree features lead due to temporal confounding. Meteorological features (latitude, spline geometry) follow}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}SHAP Explainability Analysis}{4}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}SHAP Feature Importance}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mean absolute SHAP values for the top-30 features. Latitude dominates with mean $|\text  {SHAP}| = 4.2$\,kt, followed by geographic features. Vedic-speed features (e.g., \texttt  {vedic\_chandra\_speed}) appear in the top 10.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:shap_bar}{{4}{5}{Mean absolute SHAP values for the top-30 features. Latitude dominates with mean $|\text {SHAP}| = 4.2$\,kt, followed by geographic features. Vedic-speed features (e.g., \texttt {vedic\_chandra\_speed}) appear in the top 10}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Contrast: top-25 vs bottom-25 features by mean $|$SHAP$|$. Bottom features are predominantly trigonometric altitude encodings (e.g., \texttt  {mars\_sin\_alt}, \texttt  {saturn\_sin\_alt}) with near-zero SHAP values.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:shap_contrast}{{5}{5}{Contrast: top-25 vs bottom-25 features by mean $|$SHAP$|$. Bottom features are predominantly trigonometric altitude encodings (e.g., \texttt {mars\_sin\_alt}, \texttt {saturn\_sin\_alt}) with near-zero SHAP values}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}SHAP Feature Interactions}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Top-15 SHAP Feature Interactions by Mean Interaction Value}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:shap_interact}{{1}{6}{Top-15 SHAP Feature Interactions by Mean Interaction Value}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Top-20 SHAP feature interactions. Latitude $\times $ spline\_bearing\_deg is the dominant pair (interaction value $= 0.822$), reflecting how geographic position modulates storm track curvature effects on intensity.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:shap_interact}{{6}{7}{Top-20 SHAP feature interactions. Latitude $\times $ spline\_bearing\_deg is the dominant pair (interaction value $= 0.822$), reflecting how geographic position modulates storm track curvature effects on intensity}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}LIME Explainability and SHAP vs LIME Consensus}{7}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Normalised SHAP vs LIME importance for the top-20 consensus features. Both methods agree on geographic and track features dominating. Disagreements appear for trajectory-geometry features (e.g., \texttt  {spline\_curvature} ranks higher in SHAP than LIME).}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:shap_vs_lime}{{7}{8}{Normalised SHAP vs LIME importance for the top-20 consensus features. Both methods agree on geographic and track features dominating. Disagreements appear for trajectory-geometry features (e.g., \texttt {spline\_curvature} ranks higher in SHAP than LIME)}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Vedic Category Analysis: Kruskal--Wallis Tests}{8}{section.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Kruskal--Wallis Test Results: Vedic Categories vs Wind Speed. BH-corrected significance threshold $\alpha = 0.05$.}}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:kw}{{2}{8}{Kruskal--Wallis Test Results: Vedic Categories vs Wind Speed. BH-corrected significance threshold $\alpha = 0.05$}{table.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Nakshatra Intensity Analysis}{9}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Median wind speed (kt) per Nakshatra, sorted descending with IQR error bars. Numbers above bars indicate observation count per Nakshatra. The $\approx 4$\,kt range across Nakshatras is statistically significant but practically negligible ($\varepsilon ^2 \approx 0.002$).}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:nakshatra}{{8}{9}{Median wind speed (kt) per Nakshatra, sorted descending with IQR error bars. Numbers above bars indicate observation count per Nakshatra. The $\approx 4$\,kt range across Nakshatras is statistically significant but practically negligible ($\varepsilon ^2 \approx 0.002$)}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Tithi $\times $ Nakshatra Interaction Heatmaps}{9}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Mean wind speed (kt) by Tithi (rows) and Nakshatra (columns). Darker cells indicate higher mean wind. Cells with no observations appear white. The pattern reflects the co-occurrence structure of the Vedic calendar rather than independent effects.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:tn_mean}{{9}{9}{Mean wind speed (kt) by Tithi (rows) and Nakshatra (columns). Darker cells indicate higher mean wind. Cells with no observations appear white. The pattern reflects the co-occurrence structure of the Vedic calendar rather than independent effects}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Median wind speed (kt) by Tithi (rows) and Nakshatra (columns). More robust to outliers than the mean heatmap. No systematic high-intensity zone is visible across any Tithi--Nakshatra combination.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:tn_median}{{10}{10}{Median wind speed (kt) by Tithi (rows) and Nakshatra (columns). More robust to outliers than the mean heatmap. No systematic high-intensity zone is visible across any Tithi--Nakshatra combination}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}Retrograde Planetary Motion and Storm Intensity}{10}{section.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Retrograde vs Direct Planetary Motion: Mann--Whitney U Results. $N_{\text  {retro}}$ and $N_{\text  {direct}}$ sum to $\approx $ 47,533. Wind difference = median(retrograde) $-$ median(direct). ${}^*$ = significant at $p < 0.05$.}}{10}{table.caption.14}\protected@file@percent }
\newlabel{tab:retro}{{3}{10}{Retrograde vs Direct Planetary Motion: Mann--Whitney U Results. $N_{\text {retro}}$ and $N_{\text {direct}}$ sum to $\approx $ 47,533. Wind difference = median(retrograde) $-$ median(direct). ${}^*$ = significant at $p < 0.05$}{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Retrograde vs direct median wind speed per planet. Asterisks ($^*$) indicate statistical significance ($p < 0.05$). All differences are $\leq 4$\,kt. Arun and Varun show the largest differences, but these outer planets are retrograde for $>50\%$ of observations, making the groups unequal.}}{11}{figure.caption.15}\protected@file@percent }
\newlabel{fig:retrograde}{{11}{11}{Retrograde vs direct median wind speed per planet. Asterisks ($^*$) indicate statistical significance ($p < 0.05$). All differences are $\leq 4$\,kt. Arun and Varun show the largest differences, but these outer planets are retrograde for $>50\%$ of observations, making the groups unequal}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}Planetary Aspect Correlations}{11}{section.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Planetary Aspect Pearson Correlations with Wind Speed (all 47,533 observations). Maximum $|r| = 0.0766$.}}{11}{table.caption.16}\protected@file@percent }
\newlabel{tab:aspects}{{4}{11}{Planetary Aspect Pearson Correlations with Wind Speed (all 47,533 observations). Maximum $|r| = 0.0766$}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Pearson correlations of planetary aspect angles with wind speed. The Jupiter--Saturn aspect shows the highest positive correlation ($r = 0.077$), and Venus--Jupiter the most negative ($r = -0.039$). All correlations are weak ($|r| < 0.10$).}}{12}{figure.caption.17}\protected@file@percent }
\newlabel{fig:aspects}{{12}{12}{Pearson correlations of planetary aspect angles with wind speed. The Jupiter--Saturn aspect shows the highest positive correlation ($r = 0.077$), and Venus--Jupiter the most negative ($r = -0.039$). All correlations are weak ($|r| < 0.10$)}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11}Vedic Planetary Degree: Circular-Linear Correlations}{12}{section.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Circular-Linear Correlations: Vedic Planet Degrees vs Wind Speed. $r_{\sin }$ = Pearson correlation of $\sin (\text  {degree})$ with wind; $r_{\cos }$ = Pearson correlation of $\cos (\text  {degree})$ with wind; $r_{\text  {circ}}$ = $\max (|r_{\sin }|, |r_{\cos }|)$.}}{13}{table.caption.18}\protected@file@percent }
\newlabel{tab:vedic_circ}{{5}{13}{Circular-Linear Correlations: Vedic Planet Degrees vs Wind Speed. $r_{\sin }$ = Pearson correlation of $\sin (\text {degree})$ with wind; $r_{\cos }$ = Pearson correlation of $\cos (\text {degree})$ with wind; $r_{\text {circ}}$ = $\max (|r_{\sin }|, |r_{\cos }|)$}{table.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Circular-linear correlations $r_{\text  {circ}}$ per Vedic planet degree. Yama (\texttt  {vedic\_yam}) shows the highest correlation ($r \approx 0.089$), followed by Guru/Jupiter ($r \approx 0.071$). All correlations are below $0.10$ --- explaining less than $1\%$ of wind speed variance.}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:vedic_circ}{{13}{13}{Circular-linear correlations $r_{\text {circ}}$ per Vedic planet degree. Yama (\texttt {vedic\_yam}) shows the highest correlation ($r \approx 0.089$), followed by Guru/Jupiter ($r \approx 0.071$). All correlations are below $0.10$ --- explaining less than $1\%$ of wind speed variance}{figure.caption.19}{}}
